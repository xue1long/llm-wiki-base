# =============================================================================
# ruflo-kb 环境变量模板 (env.example)
#
# 用法:
#   cp env.example .env      # 复制为 .env
#   然后填入你的真实密钥       # 请勿把真实密钥提交进 git
#
# 本项目在导入时通过 python-dotenv 自动加载 .env。
# 对于 OpenAI / Anthropic, 代码会自动读取下方同名变量作为 api_key。
# 对于 MiniMax / Kimi / DeepSeek / GLM (均为 OpenAI 兼容接口),
# 需先用 `llm-providers add` 注册, 注册时不带 --api-key 即可让它从环境变量取值。
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (官方, 向量库默认 1536 维, 与 text-embedding-3-small 天然匹配)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Anthropic (仅对话, 无 embeddings API -> 不能单独用于建向量库)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# -----------------------------------------------------------------------------
# MiniMax (OpenAI 兼容)
# -----------------------------------------------------------------------------
MINIMAX_API_KEY=sk-cp-XXl2zpVnBbF9E9LcaOlSmGf6SZq1Jt1fevaXSs04vs9OKRhiJMx0uyGrhOH3B2y-728toe_t3BWjfOEAbXKWWZaH0zIOJBvPugcF5M0u9p5nVuK422iTUz4
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_CHAT_MODEL=MiniMax-Text-01

# -----------------------------------------------------------------------------
# Kimi / Moonshot (OpenAI 兼容)
# -----------------------------------------------------------------------------
KIMI_API_KEY=your-kimi-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_CHAT_MODEL=moonshot-v1-8k

# -----------------------------------------------------------------------------
# DeepSeek (OpenAI 兼容)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# GLM / 智谱 (OpenAI 兼容)
# -----------------------------------------------------------------------------
GLM_API_KEY=your-glm-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4-plus

# -----------------------------------------------------------------------------
# 深度研究: Tavily 联网搜索 (research run 时使用)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-key

# =============================================================================
# 注册国产模型到 ruflo-kb (OpenAI 兼容方式)
#   注册时省略 --api-key, 则运行时会自动读取上方对应的 *_API_KEY 环境变量。
#
#   python -m src.cli llm-providers add minimax openai \
#       --base-url "$MINIMAX_BASE_URL" --model "$MINIMAX_CHAT_MODEL"
#   python -m src.cli llm-providers add kimi openai \
#       --base-url "$KIMI_BASE_URL" --model "$KIMI_CHAT_MODEL"
#   python -m src.cli llm-providers add deepseek openai \
#       --base-url "$DEEPSEEK_BASE_URL" --model "$DEEPSEEK_CHAT_MODEL"
#   python -m src.cli llm-providers add glm openai \
#       --base-url "$GLM_BASE_URL" --model "$GLM_CHAT_MODEL"
#   python -m src.cli llm-providers set-default <其中一个名字>
#
# 重要: 向量库使用 1536 维 LanceDB。
#   - 只有 OpenAI text-embedding-3-small 天然匹配 1536 维。
#   - 若用上述国产模型做 embeddings, 必须确认其输出维度 = 1536, 否则检索会报错。
#   - 推荐: 对话(LLM)用国产模型, embeddings 仍用 OpenAI 或本地 Ollama。
# =============================================================================
