__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- environment setup (see docs/environment/SETUP.md) ---
# Vendored wheels are large and platform-specific; keep them in-tree as
# a convenience for the verified environment but don't commit.
docs/environment/wheels/

# --- tool runtime artifacts ---
.claude/worktrees/
.claude/sdd/
.workbuddy/
codebase-index-report.md
registry.json

# --- project memory (session-specific, not for commit) ---
.memory/

# local secrets (API keys)
.env

# wiki spec sync
.wiki-spec-md5

# --- runtime artifacts (per-project data, not source) ---
# The following are generated when the server runs or when ingest
# happens; they belong to a specific project + machine and should not
# be committed.
# vector index dir
.index/*
# Phase 4 P1 P0 加固（plan guidance #6）：门禁/对账数据 git 跟踪——
# 用 gitignore 例外规则白名单放行（钉死，非 force-add）。lancedb 不入 git
# （不在例外列表），依赖"每批向量 upsert 可重放"。
!.index/batch_build_state.json
!.index/knowledge_gaps.json
!.index/batch_reports/
!.index/batch_reports/*.json
!.index/reingest_plan.json
# LLM cache dir
.llm-wiki
# Obsidian vault (when this repo is opened in Obsidian)
.obsidian
# queue persistence (in-memory state is canonical)
.kb-queue.json
.kb-queue.json.failed
.kb-queue-paused
# rotated queue backups
.kb-queue.json.bak*
# server daemon pidfile
.server-pid
# metrics sqlite db
metrics.db

# Backups of wiki/ contents left from earlier rounds
.wiki-*-backup

# Log files (runtime artifacts)
*.log
.server.log.*

# --- agent/tool runtime dirs ---
.agents/
.codebuddy/
.minimax/
.trae/
.venv/

# one-off debug / scratch scripts
_check_*.py
_fix_*.py
_revert_*.py
_test_output.txt
_revert_files.txt
